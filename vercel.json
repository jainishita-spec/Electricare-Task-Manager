{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "{frontend/**,brand.json,node_modules/@fontsource/*/files/*.woff2}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ],
  "crons": [
    { "path": "/api/cron/reminders", "schedule": "30 6 * * *" },
    { "path": "/api/cron/whatsapp", "schedule": "0 4 * * 1-6" }
  ]
}
